# ─── Database (Supabase Postgres via Supavisor pooler) ───
# Use the "Transaction" pooler URL (port 6543) for the app, "Session" (5432) for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Supabase (new API key system) ───
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."   # replaces the legacy anon key
SUPABASE_SECRET_KEY="sb_secret_..."             # replaces the legacy service_role key (server-only)
SUPABASE_JWT_SECRET="<jwt-secret>"              # for verifying GoTrue JWTs server-side

# ─── Server ───
PORT="4000"
NODE_ENV="development"
# Public origin where the app + API are reachable (one origin; prod serves both).
# Auto-derived from RAILWAY_PUBLIC_DOMAIN on Railway.
SERVER_ORIGIN="http://localhost:5173"
# Apply pending Drizzle migrations on boot. Set "false" if your deploy pipeline
# runs them manually.
AUTO_MIGRATE="true"
# Shared secret for the public partner REST API (X-API-Key). Unset → API disabled.
PARTNER_API_KEY=""

# ─── Redis (BullMQ) ───
REDIS_URL="redis://localhost:6379"

# ─── Stripe ───
STRIPE_SECRET_KEY="sk_test_..."
# Publishable key served to frontends that mount Stripe Elements against a
# backend-provided config (beta.billingConfig, shortLinks.billingConfig). This is
# the SERVER-side copy — the client build uses VITE_STRIPE_PUBLISHABLE_KEY below.
# Both must be set, and to the same key.
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# One webhook URL can back SEVERAL Stripe dashboard endpoints (one per event
# type), each with its own signing secret. All three below are tried in turn
# until one verifies the signature (modules/stripe/webhook.ts) — set whichever
# your endpoints use; at least one is required for the webhook to accept traffic.
#
# STRIPE_WEBHOOK_SECRET is the catch-all/production dashboard endpoint secret. In
# local dev you do NOT set it by hand: `bun run dev` starts the Stripe CLI
# listener (scripts/stripe-listen.mjs), which writes the CLI's local signing
# secret to .env.stripe.local and the server loads it with override. One-time
# setup: install the Stripe CLI and run `stripe login`.
STRIPE_WEBHOOK_SECRET="whsec_..."
CHECKOUT_SESSION_COMPLETED_WEBHOOK_SECRET="whsec_..."
STRIPE_ACCOUNT_UPDATED_WEBHOOK_SECRET="whsec_..."

# ─── Payouts ───
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""                # verifies inbound PayPal payout webhooks
WISE_API_TOKEN=""
WISE_PROFILE_ID=""
WISE_STRIPE_CONNECT_ACCOUNT_ID=""   # Wise's Stripe Connect account — leg-1 funding target
# OAuth app used to link a contractor's own Wise recipient account (routers/users.ts).
WISE_CLIENT_ID=""
WISE_CLIENT_SECRET=""
# Note: Wise's webhook-signature key is NOT configured here — it is Wise's
# published PUBLIC key, pinned in server-shared/lib/env.ts.

# ─── Google (Calendar integration — separate from Supabase Google sign-in) ───
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
#     Optional. Server-side Places key powering address autocomplete (Company
#     Info → Locations). Kept on the backend — the SPA calls the `places` tRPC
#     router, so this key is never shipped to the browser. Without it the
#     address field falls back to plain text.
GOOGLE_MAPS_API_KEY=""

# ─── AI providers — one key per provider FAMILY. The assistant is disabled only
#     when NO family has a key; a brand picks the family it uses. ───
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY=""

# ─── Outreach (super-admin cold email) — all server-side only ───
# Smartlead sends the campaigns; unset → the Outreach screens render a setup prompt.
SMARTLEAD_API_KEY=""
# The name of THIS environment's one campaign, created on first visit to the
# Sending Email tab. Every environment — local included — shares ONE Smartlead
# account, so the name is the only thing keeping the campaigns apart: give each
# one a distinct value and never point two environments at the same name.
# Unset → the Sending Email tab reports that nothing is configured.
OUTREACH_CAMPAIGN_NAME="ProDesk Outreach — LOCAL"
# Smartlead does NOT sign its callbacks, so the callback URL itself is the
# credential: /api/outreach/webhook/<secret>. Unset → the endpoint refuses every
# request. Use a long random string.
OUTREACH_WEBHOOK_SECRET=""
# List building — Google Maps scrape via Apify. Unset → the List Builder renders a
# setup prompt. Actor id uses Apify's API form `owner~name` (the store URL writes
# the same actor as compass/crawler-google-places); the default below is used when
# the var is unset.
APIFY_TOKEN="apify_api_..."
APIFY_MAPS_ACTOR_ID="compass~crawler-google-places"
# Email verification. MANDATORY for list building — a run refuses to start without
# it, because bounces burn a sending domain faster than anything else we do.
MILLIONVERIFIER_API_KEY=""
# Optional drop-in alternative to Apify. Note it cannot be asked "did I already
# start this run?", so a stalled run on it will not auto-resume.
OUTSCRAPER_API_KEY=""
# The outreach twin of EMAIL_DEV_REDIRECT below. Set it and every recipient is
# rewritten to this address on the way to Smartlead, with a line in the terminal
# naming who the mail was actually meant for — so the pipeline can be run end to
# end without a stranger receiving cold email. Leave EMPTY in every hosted env.
# Note the batch collapses onto one inbox, so a push of 400 uploads as one lead.
OUTREACH_DEV_REDIRECT=""

# ─── Email (SMTP / Nodemailer) ───
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"   # true for implicit TLS (port 465); 587 uses STARTTLS
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Prodesk <no-reply@prodesk.com>"
EMAIL_DEV_REDIRECT="sajat.s@noize.com.au"
# Extra apex domains (comma-separated) trusted as outbound-email link origins, on
# top of the always-allowed prodesk.com; each entry covers its subdomains too.
# Only needed for white-label frontend domains NOT under prodesk.com — the link
# origin comes from the client-controlled x-client-origin header, so it must be
# allow-listed. Leave empty when every frontend is a *.prodesk.com host.
EMAIL_ALLOWED_ORIGINS=""

# ─── Sentry ───
SENTRY_DSN=""

# ─── Client (Vite — must be prefixed VITE_) ───
VITE_SUPABASE_URL="https://<ref>.supabase.co"
# development | staging | production — non-production shows an env chip in the nav.
VITE_APP_ENV="development"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Origin of the API server.
#   • Dev: target for the Vite dev-server `/trpc` proxy (localhost:4000).
#   • Prod with SEPARATE frontend + backend services (current Railway setup):
#     REQUIRED. The browser client calls `${VITE_API_URL}/trpc` (see
#     packages/shared/src/lib/trpc.ts), so each FRONTEND build must bake in the
#     backend's public URL — otherwise it falls back to a relative `/trpc` that
#     hits the static frontend and 404s.
#     Set it on the BACKEND service too: the server keys
#     `isBackendHostedSeperately` off its presence (server/src/lib/env.ts) to
#     skip serving a bundled SPA it no longer builds.
#   • Prod with ONE service serving both: leave unset — same-origin `/trpc` works.
VITE_API_URL="http://localhost:4000"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."



# ─── HOSTED ORIGINS ───
VITE_APP_PRODESK_ORIGIN="app.prodesk.com"
VITE_DASHBOARD_PRODESK_ORIGIN="dashboard.prodesk.com"
VITE_LINKS_PRODESK_ORIGIN="links.prodesk.com"
VITE_REVIEWS_PRODESK_ORIGIN="reviews.prodesk.com"
VITE_REDIRECTOR_PRODESK_ORIGIN="url.prodesk.com"
VITE_PAYMENTS_PRODESK_ORIGIN="payments.prodesk.com"
VITE_SIGNATURES_PRODESK_ORIGIN="signatures.prodesk.com"
VITE_JOBS_PRODESK_ORIGIN="jobs.prodesk.com"
VITE_WEBSITES_PRODESK_ORIGIN="websites.prodesk.com"
VITE_DESIGN_PRODESK_ORIGIN="design.prodesk.com"
VITE_LOGO_PRODESK_ORIGIN="logo.prodesk.com"
VITE_CHAT_PRODESK_ORIGIN="chat.prodesk.com"




# ─── PAYMENTS (EziQuotes) TOOL ───
# All optional — each integration degrades gracefully when unset.
# Public origin of the payments client, used by workers (no request ctx) to
# build payer-facing links (surveys, portal, proposals). MUST include the scheme —
# it is parsed with `new URL()` by the email origin allow-list, so a bare host is
# silently rejected and the links fall back to the main app origin.
PAYMENTS_ORIGIN="https://payments.prodesk.com"
# Stripe Connect OAuth client id (ca_...) for vendor account linking.
STRIPE_CLIENT_ID=""
# Global Twilio fallback for vendors without their own creds (per-account
# twilio_* columns on payment_accounts win when set).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_ALPHA_SENDER=""
TWILIO_FROM_NUMBER=""
# Global Postmark fallback (per-account postmark_* columns win when set).
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_DOMAIN=""
# Accounting + CRM OAuth apps.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
MYOB_CLIENT_ID=""
MYOB_CLIENT_SECRET=""
PIPEDRIVE_CLIENT_ID=""
PIPEDRIVE_CLIENT_SECRET=""
