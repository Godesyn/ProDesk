{
  "name": "@prodesk/server-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./db": {
      "development": "./src/db/index.ts",
      "import": "./dist/db/index.js",
      "default": "./dist/db/index.js"
    },
    "./db/*": {
      "development": "./src/db/*.ts",
      "import": "./dist/db/*.js",
      "default": "./dist/db/*.js"
    },
    "./lib/*": {
      "development": "./src/lib/*.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./modules/*": {
      "development": "./src/modules/*.ts",
      "import": "./dist/modules/*.js",
      "default": "./dist/modules/*.js"
    },
    "./routers/*": {
      "development": "./src/routers/*.ts",
      "import": "./dist/routers/*.js",
      "default": "./dist/routers/*.js"
    },
    "./trpc/*": {
      "development": "./src/trpc/*.ts",
      "import": "./dist/trpc/*.js",
      "default": "./dist/trpc/*.js"
    },
    "./jobs/*": {
      "development": "./src/jobs/*.ts",
      "import": "./dist/jobs/*.js",
      "default": "./dist/jobs/*.js"
    },
    "./test/*": {
      "development": "./src/test/*.ts",
      "import": "./dist/test/*.js",
      "default": "./dist/test/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@bull-board/api": "^6.0.0",
    "@bull-board/express": "^6.0.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^2.13.0",
    "@sentry/node": "^8.30.0",
    "@supabase/supabase-js": "^2.45.0",
    "@trpc/server": "^11.0.0",
    "bullmq": "^5.13.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "fluent-ffmpeg": "^2.1.3",
    "fontkit": "^2.0.4",
    "fractional-indexing": "^4.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.0",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.2",
    "postgres": "^3.4.4",
    "sharp": "^0.33.5",
    "stripe": "^17.0.0",
    "superjson": "^2.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.9",
    "@types/uuid": "^10.0.0",
    "firebase-admin": "^13.7.0",
    "typescript": "^5.6.0",
    "uuid": "^11.0.0",
    "vitest": "^2.1.0"
  }
}
