{
  "name": "redirector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions development src/index.ts",
    "build": "bun run --filter '@prodesk/server-shared' build && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prodesk/server-shared": "workspace:*",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fast-geoip": "^1.1.88"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
